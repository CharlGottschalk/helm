{
  "contract": "helm.tool/1",
  "id": "kanban",
  "name": "Kanban",
  "version": "0.1.0",
  "description": "Software-production tasks by status. Start builds from ready cards with tdt-software-production.",
  "icon": "grid",
  "multi": true,
  "settings": [
    { "id": "project", "type": "select", "label": "Project", "required": true,
      "options": { "from": "connection", "connection": "tdt", "call": "tdt_project_list" } },
    { "id": "host", "type": "choice", "label": "Build with", "options": ["claude", "codex"], "default": "claude" },
    { "id": "showCancelled", "type": "checkbox", "label": "Show cancelled", "default": false },
    { "id": "wipLimit", "type": "number", "label": "Doing limit", "min": 1, "max": 20, "step": 1, "default": 3 }
  ],
  "connections": [ { "id": "tdt", "kind": "tdt-mcp", "operations": ["tdt_project_list", "tdt_project_read"] } ],
  "capabilities": ["orchestrate"],
  "permissions": { "write": false },
  "entry": "index.html"
}
