{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helm.local/contracts/settings.schema.json",
  "title": "Helm settings fields (v1)",
  "type": "array",
  "maxItems": 24,
  "items": { "$ref": "#/$defs/field" },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
      "not": { "pattern": "(?i)(token|password|secret|apikey|api_key|credential)" } },
    "common": {
      "type": "object",
      "required": ["id", "type", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "help": { "type": "string", "maxLength": 400 },
        "required": { "type": "boolean" },
        "group": { "type": "string", "maxLength": 60 }
      }
    },
    "option": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 200 },
        { "type": "object", "required": ["value", "label"], "additionalProperties": false,
          "properties": { "value": { "type": "string", "maxLength": 200 }, "label": { "type": "string", "maxLength": 200 } } }
      ]
    },
    "options": {
      "oneOf": [
        { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/option" } },
        { "type": "object", "required": ["from", "connection", "call"], "additionalProperties": false,
          "properties": {
            "from": { "const": "connection" },
            "connection": { "type": "string" },
            "call": { "type": "string" }
          } }
      ]
    },
    "field": {
      "allOf": [{ "$ref": "#/$defs/common" }],
      "oneOf": [
        { "properties": { "type": { "const": "text" },
            "default": { "type": "string", "maxLength": 2000 },
            "placeholder": { "type": "string", "maxLength": 120 },
            "multiline": { "type": "boolean" },
            "pattern": { "type": "string", "maxLength": 200 },
            "maxLength": { "type": "integer", "minimum": 1, "maximum": 2000 } } },
        { "required": ["options"], "properties": { "type": { "const": "select" },
            "options": { "$ref": "#/$defs/options" },
            "default": { "type": "string" } } },
        { "required": ["options"], "properties": { "type": { "const": "choice" },
            "options": { "$ref": "#/$defs/options" },
            "multiple": { "type": "boolean" },
            "min": { "type": "integer", "minimum": 0 },
            "max": { "type": "integer", "minimum": 1 },
            "default": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] } } },
        { "properties": { "type": { "const": "checkbox" },
            "required": { "const": false },
            "default": { "type": "boolean" } } },
        { "properties": { "type": { "const": "number" },
            "min": { "type": "number" }, "max": { "type": "number" },
            "step": { "type": "number", "exclusiveMinimum": 0 },
            "unit": { "type": "string", "maxLength": 16 },
            "default": { "type": "number" } } }
      ]
    }
  }
}
