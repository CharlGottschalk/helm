{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "typecheck": { "dependsOn": ["^build"] },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "server/dist/**", "contracts/**"]
    },
    "dev": { "cache": false, "persistent": true },
    "dev:server": { "cache": false, "persistent": true }
  }
}
